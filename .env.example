# ---- Database (docker compose maps 5432 -> 5433 to avoid clashing with a local postgres) ----
DATABASE_URL="postgresql://cockpit:cockpit@localhost:5439/cockpit?schema=public"

# ---- API ----
PORT=4010
NODE_ENV=development
JWT_SECRET="change-me-in-production"
CORS_ORIGIN="http://localhost:5190"

# ---- Storage (FR-1.1, NFR-7.1) ----
STORAGE_ROOT="./storage"
MAX_UPLOAD_BYTES=20971520

# ---- Extraction: FR-4 ----
# EXTRACTION_PROVIDER: gemini | mock
EXTRACTION_PROVIDER=gemini
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"
EXTRACTION_TIMEOUT_MS=120000
EXTRACTION_MAX_ATTEMPTS=3
CONFIDENCE_THRESHOLD=0.85

# ---- Controls (OQ-01, OQ-02) ----
SOD_REQUIRE_SEPARATE_APPROVER=true
DUPLICATE_POLICY=warn

# ---- SAP folder-drop integration: FR-9, FR-10, IC-01..12 ----
INTEGRATION_ROOT="./integration"
# COMPLETENESS_CONVENTION: rename | done_marker   (OQ-04)
COMPLETENESS_CONVENTION=done_marker
# CSV_LAYOUT: single_file | header_lines_pair     (OQ-03, FR-9.3)
CSV_LAYOUT=single_file
CSV_DELIMITER=","
CSV_HEADER_ROW=false
# How dates and decimals are written to SAP, whatever form the PO used:
# CSV_DATE_FORMAT: iso (2026-09-17) | yyyymmdd (20260917) | dd.mm.yyyy (17.09.2026)
CSV_DATE_FORMAT=iso
# CSV_DECIMAL_SEPARATOR: . | ,
CSV_DECIMAL_SEPARATOR=.
CSV_ENCODING=utf8
SAP_RESULT_POLL_MS=3000
SAP_SLA_TIMEOUT_MS=3600000

# ---- Workers ----
EXTRACTION_POLL_MS=2000

# ---- SAP simulator (stands in for the real S/4HANA polling job) ----
SAP_SIM_POLL_MS=2000
SAP_SIM_PROCESSING_MS=4000
SAP_SIM_FAILURE_RATE=0.15

# ---- ZEE_API_LOG: direct SAP API keyed by Sales Order (IT_SALEORDERS-VBELN, CHAR10) ----
# SAP_LOG_API_MODE: off | mock | live
#   mock answers inside the cockpit; live POSTs to SAP_LOG_API_URL.
SAP_LOG_API_MODE=mock
# e.g. https://<sap-host>:<port>/sap/bc/<icf-path>  (REST)  or the SOAMANAGER binding URL (SOAP)
SAP_LOG_API_URL=""
# SAP_LOG_API_FORMAT: json | soap
SAP_LOG_API_FORMAT=json
SAP_LOG_API_USER=""
SAP_LOG_API_PASSWORD=""
# sent as ?sap-client=
SAP_CLIENT=""
# true when the service enforces CSRF (typical for Gateway; 403 "CSRF token validation failed")
SAP_LOG_API_CSRF=false
SAP_LOG_API_TIMEOUT_MS=30000

# ---- Dashboard: the assumptions behind "time saved" (estimates of how long a person takes, not measurements) ----
# Keying a PO into SAP by hand: minutes for the PO, plus minutes per line.
DASHBOARD_MANUAL_MIN_PER_PO=4
DASHBOARD_MANUAL_MIN_PER_LINE=1.5
# Checking what the cockpit read against the PDF: per PO, per line, and per field corrected.
DASHBOARD_REVIEW_MIN_PER_PO=1.5
DASHBOARD_REVIEW_MIN_PER_LINE=0.25
DASHBOARD_MIN_PER_CORRECTION=0.5

# ---- Notifications (FR-14). The in-app bell needs nothing; email and Teams stay off until set. ----
# Where the app is reached, for the "Open" links in messages.
PUBLIC_BASE_URL=http://localhost:5190
# Email: leave SMTP_HOST empty and no email is ever sent.
SMTP_HOST=""
SMTP_PORT=587
# true for port 465; false for STARTTLS on 587 or a plain test relay
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="PO Cockpit <po-cockpit@example.com>"
# Send ALL email to this one address instead of to the real recipients (demos, trials).
NOTIFY_EMAIL_OVERRIDE_TO=""
# A Teams "Workflows" webhook URL ("Post to a channel when a webhook request is received").
# The URL is a secret. Empty means no Teams messages.
NOTIFY_TEAMS_WEBHOOK_URL=""
# Which kinds go to Teams, comma-separated (REVIEW_NEEDED, SENT_BACK, RECORD_FAILED,
# EXTRACTION_FAILED, SO_CREATED, INTEGRATION_ALERT). Empty means all.
NOTIFY_TEAMS_KINDS=""
NOTIFY_DELIVERY_POLL_MS=5000
NOTIFY_MAX_ATTEMPTS=5
