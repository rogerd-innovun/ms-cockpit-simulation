# ---- Database (docker compose maps 5432 -> 5433 to avoid clashing with a local postgres) ----
DATABASE_URL="postgresql://cockpit:cockpit@localhost:5439/cockpit?schema=public"

# ---- API ----
PORT=4010
NODE_ENV=development
JWT_SECRET="change-me-in-production"
CORS_ORIGIN="http://localhost:5190"

# ---- Storage (FR-1.1, NFR-7.1) ----
STORAGE_ROOT="./storage"
MAX_UPLOAD_BYTES=20971520

# ---- Extraction: FR-4 ----
# EXTRACTION_PROVIDER: gemini | mock
EXTRACTION_PROVIDER=gemini
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"
EXTRACTION_TIMEOUT_MS=120000
EXTRACTION_MAX_ATTEMPTS=3
CONFIDENCE_THRESHOLD=0.85

# ---- Controls (OQ-01, OQ-02) ----
SOD_REQUIRE_SEPARATE_APPROVER=true
DUPLICATE_POLICY=warn

# ---- SAP folder-drop integration: FR-9, FR-10, IC-01..12 ----
INTEGRATION_ROOT="./integration"
# COMPLETENESS_CONVENTION: rename | done_marker   (OQ-04)
COMPLETENESS_CONVENTION=done_marker
# CSV_LAYOUT: single_file | header_lines_pair     (OQ-03, FR-9.3)
CSV_LAYOUT=single_file
CSV_DELIMITER=","
CSV_HEADER_ROW=false
# How dates and decimals are written to SAP, whatever form the PO used:
# CSV_DATE_FORMAT: iso (2026-09-17) | yyyymmdd (20260917) | dd.mm.yyyy (17.09.2026)
CSV_DATE_FORMAT=iso
# CSV_DECIMAL_SEPARATOR: . | ,
CSV_DECIMAL_SEPARATOR=.
CSV_ENCODING=utf8
SAP_RESULT_POLL_MS=3000
SAP_SLA_TIMEOUT_MS=3600000

# ---- Workers ----
EXTRACTION_POLL_MS=2000

# ---- SAP simulator (stands in for the real S/4HANA polling job) ----
SAP_SIM_POLL_MS=2000
SAP_SIM_PROCESSING_MS=4000
SAP_SIM_FAILURE_RATE=0.15

# ---- ZEE_API_LOG: direct SAP API keyed by Sales Order (IT_SALEORDERS-VBELN, CHAR10) ----
# SAP_LOG_API_MODE: off | mock | live
#   mock answers inside the cockpit; live POSTs to SAP_LOG_API_URL.
SAP_LOG_API_MODE=mock
# e.g. https://<sap-host>:<port>/sap/bc/<icf-path>  (REST)  or the SOAMANAGER binding URL (SOAP)
SAP_LOG_API_URL=""
# SAP_LOG_API_FORMAT: json | soap
SAP_LOG_API_FORMAT=json
SAP_LOG_API_USER=""
SAP_LOG_API_PASSWORD=""
# sent as ?sap-client=
SAP_CLIENT=""
# true when the service enforces CSRF (typical for Gateway; 403 "CSRF token validation failed")
SAP_LOG_API_CSRF=false
SAP_LOG_API_TIMEOUT_MS=30000
